rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /menuItems/{itemId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      // Any signed-in user (not just admin) can update stock/availability —
      // needed for staff toggling availability and checkout decrementing
      // stock. Renaming/repricing/recategorizing an item stays admin-only.
      allow update: if isAdmin()
        || (
          isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['stockCount', 'available', 'updatedAt']) &&
          request.resource.data.stockCount is int &&
          request.resource.data.stockCount >= 0 &&
          request.resource.data.available is bool
        );
    }

    match /orders/{orderId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false; // role assignment via admin SDK / console only, not client-writable
    }
  }
}
